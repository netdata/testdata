# Synthetic observations from pinned public SGLang instrumentation; no operational data.
# One native encoder endpoint; separate DP workers and request partitions where configured.
# HELP sglang:encoder_dp_pending_requests Number of pending requests per encoder DP rank.
# TYPE sglang:encoder_dp_pending_requests gauge
sglang:encoder_dp_pending_requests{dp_rank="0",model_name="model_a"} 1
sglang:encoder_dp_pending_requests{dp_rank="1",model_name="model_a"} 2
# HELP sglang:process_cpu_seconds_total Total CPU time consumed by this process (user + system)
# TYPE sglang:process_cpu_seconds_total counter
sglang:process_cpu_seconds_total{component="scheduler"} 2
# HELP sglang:func_latency_seconds Function latency in seconds
# TYPE sglang:func_latency_seconds histogram
