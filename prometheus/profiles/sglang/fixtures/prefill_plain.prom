# Synthetic observations from pinned public SGLang instrumentation; no operational data.
# One native prefill endpoint; separate DP workers and request partitions where configured.
# HELP sglang:failed_session_recoveries_total Number of mooncake_session_ids un-blacklisted via probe.
# TYPE sglang:failed_session_recoveries_total counter
sglang:failed_session_recoveries_total 2
# HELP sglang:process_cpu_seconds_total Total CPU time consumed by this process (user + system)
# TYPE sglang:process_cpu_seconds_total counter
sglang:process_cpu_seconds_total{component="scheduler"} 2
# HELP sglang:func_latency_seconds Function latency in seconds
# TYPE sglang:func_latency_seconds histogram
sglang:func_latency_seconds_bucket{le="0.05",name="forward"} 1
sglang:func_latency_seconds_bucket{le="0.07500000000000001",name="forward"} 1
sglang:func_latency_seconds_bucket{le="0.1125",name="forward"} 1
sglang:func_latency_seconds_bucket{le="0.16875",name="forward"} 1
sglang:func_latency_seconds_bucket{le="0.253125",name="forward"} 2
sglang:func_latency_seconds_bucket{le="0.3796875",name="forward"} 2
sglang:func_latency_seconds_bucket{le="0.56953125",name="forward"} 2
sglang:func_latency_seconds_bucket{le="0.8542968750000001",name="forward"} 2
sglang:func_latency_seconds_bucket{le="1.2814453125",name="forward"} 2
sglang:func_latency_seconds_bucket{le="1.9221679687500002",name="forward"} 2
sglang:func_latency_seconds_bucket{le="2.8832519531250003",name="forward"} 2
sglang:func_latency_seconds_bucket{le="4.3248779296875",name="forward"} 2
sglang:func_latency_seconds_bucket{le="6.487316894531251",name="forward"} 2
sglang:func_latency_seconds_bucket{le="9.730975341796876",name="forward"} 2
sglang:func_latency_seconds_bucket{le="14.596463012695313",name="forward"} 2
sglang:func_latency_seconds_bucket{le="21.89469451904297",name="forward"} 2
